# Copiá este archivo como .env.local (ignorado por git) y completá TUS valores. NUNCA subas credenciales reales.
# Sin estas variables la app compila pero queda SIN base de datos (modo inerte); no hay valores de respaldo.
# Production: se definen en Vercel (Settings → Environment Variables → Production). Preview: NO definirlas (o usar un proyecto de QA).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_O_PUBLISHABLE

# Opcional: enlace a la app en Google Play o APK público (modo alumno → botón «Android»)
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=TU_PAQUETE

# Solo para builds de Vercel (no usar en local salvo para probar el guard):
# VITE_REQUIRE_SUPABASE=1           # el build falla si faltan las variables de Supabase (Production ya lo exige solo)
# VITE_ALLOW_PROD_IN_PREVIEW=1      # excepcion consciente: permite que un Preview apunte a produccion
