{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge origin/main*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(node scripts/*)",
      "Bash(node */scripts/*)",
      "Bash(npx vite build*)",
      "mcp__github__create_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__get_commit",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__claude-code-remote__subscribe_pr_activity"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(vercel.json)",
      "Edit(vite.config.js)",
      "Edit(package.json)",
      "Edit(lib/envTargetGuard.js)"
    ],
    "deny": [
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__github__actions_run_trigger",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(gh pr merge*)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "Bash(psql *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(supabase/**)",
      "Write(supabase/**)",
      "Edit(sql/**)",
      "Write(sql/**)",
      "Edit(lib/supabaseClient.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__.*|mcp__claude-code-remote__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
