{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git branch --show-current)",
      "Bash(node scripts/test-*.mjs)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git pull *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Write(.gitignore)",
      "Edit(.gitignore)",
      "mcp__github__create_branch",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "mcp__github__issue_write",
      "mcp__github__sub_issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__pull_request_review_write",
      "mcp__github__resolve_review_thread",
      "mcp__github__unresolve_review_thread",
      "mcp__github__request_copilot_review"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git update-ref *)",
      "Bash(git branch -D *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(rm -rf *)",
      "Bash(printenv *)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.*)",
      "Write(.env)",
      "Write(**/.env)",
      "Write(.env.*)",
      "Read(.chrome-headless/**)",
      "Read(.chrome-scroll-test/**)",
      "Edit(.chrome-headless/**)",
      "Edit(.chrome-scroll-test/**)",
      "Edit(node_modules/**)",
      "Write(node_modules/**)",
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__github__actions_run_trigger",
      "mcp__github__enable_pr_auto_merge"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.mjs\" global"
          }
        ]
      }
    ]
  }
}
