node_modules
dist
.vercel
# Variables de entorno: nunca versionar valores. La plantilla es .env.example (sin valores).
.env
.env.*
!.env.example
.env*.local
# Claude Code: se versiona la configuracion del flujo de agentes; lo local/personal no.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
.claude/agent-memory-local/

# --- Lista blanca adicional (agentes irontrack-*, orquestador, plantilla de autorizacion) y exclusion de credenciales ---
!.claude/ORQUESTADOR.md
# Autorizacion temporal de correcciones: la crea cada persona en su maquina y NUNCA se versiona (solo la plantilla de ejemplo).
!.claude/authorization/
.claude/authorization/*
!.claude/authorization/fix.example.json
# Defensa en profundidad dentro de las carpetas permitidas: nada de secretos, llaves ni ajustes locales.
.claude/**/.env
.claude/**/.env.*
.claude/**/*.env
.claude/**/*.key
.claude/**/*.pem
.claude/**/*.token
.claude/**/*secret*
.claude/**/*credential*
.claude/**/*.local.*

# Perfiles de navegador headless (cookies, Login Data, historial): NUNCA versionar.
.chrome-headless/
.chrome-*/
.chromium-*/
.playwright-*/
# Volcados de memoria de navegadores (Crashpad): pueden contener fragmentos de memoria con sesiones.
*.dmp
Crashpad/

# S-1: llaves, certificados y credenciales locales en cualquier carpeta (el control scripts/security/secret-scan.mjs lo verifica en CI).
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
.npmrc
.supabase/
supabase/.temp/
supabase/.branches/
*.env
!*.env.example
.envrc
.dev.vars
